# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# ShipGate managed installs / reports / cache
.shipgate/tools/
.shipgate/reports/
.shipgate/cache/

# Cursor IDE local state — keep portable persona rules/skills tracked
.cursor/*
!.cursor/rules/
.cursor/rules/*
!.cursor/rules/persona/
!.cursor/rules/persona/**
!.cursor/skills/
.cursor/skills/*
!.cursor/skills/persona-check/
!.cursor/skills/persona-check/**
!.cursor/skills/update-persona/
!.cursor/skills/update-persona/**

# Generated persona reviews
reviews/

# Tool/report artifacts (e.g. jscpd)
report/

.shipgate/
adr/
scripts/
todos.md

# `scripts/` above is this repo's own local dev-script dir, not the maina
# family-dir convention (install.backend: script's install.entry: resolution
# expects a directory literally named scripts/ next to the manifest) — carve
# the worked example back out.
!examples/scripts_dir/tools/scripts/
!examples/scripts_dir/tools/scripts/**

# cache files and dir
*cache*

# Local powerhouse planning notes (the published docs site lives elsewhere in docs/)
docs/plans/
docs/reviews/

# MkDocs build output
site/

# reviewer / scratch notes
notes/
.agents/

# powerhouse agent process (plans, memory, decisions, reviews)
.powerhouse/

# local editor state (extensions, launch configs) — machine-specific
.vscode/
.claude/
